[Unit]
Description=Smart Public Bus Fleet Simulator (193 Active Delhi Buses)
After=network.target smart-bus.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/bus-project/backend
Environment="PATH=/home/ubuntu/bus-project/venv/bin:/usr/local/bin:/usr/bin"
EnvironmentFile=-/home/ubuntu/bus-project/.env
ExecStart=/home/ubuntu/bus-project/venv/bin/python simulator.py --hour 9

Restart=always
RestartSec=5s

# Security sandboxing
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/bus-project/backend/data

[Install]
WantedBy=multi-user.target
