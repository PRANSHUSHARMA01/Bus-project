[Unit]
Description=Smart Public Bus Transit Server (pranshusharma.tech)
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/bus-project/backend
Environment="PATH=/home/ubuntu/bus-project/venv/bin:/usr/local/bin:/usr/bin"
Environment="APP_ENV=production"
Environment="PORT=8000"
EnvironmentFile=-/home/ubuntu/bus-project/.env
ExecStart=/home/ubuntu/bus-project/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 2 --proxy-headers --forwarded-allow-ips "*"

Restart=always
RestartSec=5s

# Security sandboxing
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/bus-project/backend/data

# Resource limits
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
