# Backend Environment Configuration - Smart Public Bus Tracking
# Copy to .env for local development or set as environment variables on AWS EC2

# Server Port and Host
PORT=8000
HOST=0.0.0.0

# Allowed CORS Origins (Comma-separated, no wildcards in production)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://smart-bus-tracking.vercel.app

# Supabase Auth and Database
# Get these from your Supabase Project Settings -> API & Database
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-at-least-32-chars
SUPABASE_DB_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Security and Rate Limiting
DEV_AUTH_BYPASS=false
RATE_LIMIT_PER_MINUTE=60
SOS_RATE_LIMIT_PER_MINUTE=10
