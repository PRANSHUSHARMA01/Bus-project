# ==============================================================================
# Environment Configuration Example
# Copy to .env for production deployment. NEVER commit .env to version control!
# ==============================================================================

# Core Application Settings
PORT=8000
HOST=0.0.0.0
DEV_MODE=false

# PostgreSQL Database Configuration (or uses internal SQLite if DATABASE_URL is unset)
POSTGRES_USER=smartbus
POSTGRES_PASSWORD=replace_with_strong_random_password_min_32_chars
POSTGRES_DB=smartbus_db
DATABASE_URL=postgresql://smartbus:replace_with_strong_random_password_min_32_chars@db:5432/smartbus_db

# Security & CORS (Same origin on EC2 needs no CORS; allow pranshusharma.tech)
ALLOWED_ORIGINS=https://pranshusharma.tech,https://www.pranshusharma.tech

# Authentication & Cryptographic Secrets
JWT_SECRET=generate_with_openssl_rand_hex_32
SERVER_PEPPER=generate_with_openssl_rand_hex_32

# ------------------------------------------------------------------------------
# Free Email OTP Dispatch Configuration (Choose Option A, B, or C)
# ------------------------------------------------------------------------------
# Option A: Standard Free SMTP (Works with Gmail App Password, Outlook, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_character_gmail_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_USE_TLS=true

# Option B: Resend Free API (3,000 emails/month free)
# RESEND_API_KEY=re_1234567890
# RESEND_FROM_EMAIL=onboarding@resend.dev

# Option C: AWS SES (Production Mumbai region)
# AWS_DEFAULT_REGION=ap-south-1
# SES_FROM_EMAIL=login@pranshusharma.tech

# ------------------------------------------------------------------------------
# Google OAuth 2.0 Credentials (Google Cloud Console)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# GOOGLE_REDIRECT_URI=https://pranshusharma.tech/api/v1/auth/google/callback

# Web Push Notification Keys (VAPID)
VAPID_PUBLIC_KEY=replace_with_vapid_public_key
VAPID_PRIVATE_KEY=replace_with_vapid_private_key
VAPID_CLAIMS_SUB=mailto:admin@pranshusharma.tech
