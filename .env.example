# ==============================================================================
# Environment Configuration Example
# Copy to .env for production deployment. NEVER commit .env to version control!
# ==============================================================================

# Core Application Settings
PORT=8000
HOST=0.0.0.0
DEV_MODE=false

# PostgreSQL Database Configuration
POSTGRES_USER=smartbus
POSTGRES_PASSWORD=replace_with_strong_random_password_min_32_chars
POSTGRES_DB=smartbus_db
DATABASE_URL=postgresql://smartbus:replace_with_strong_random_password_min_32_chars@db:5432/smartbus_db

# Security & CORS (Same origin on EC2 needs no CORS; allow pranshusharma.tech)
ALLOWED_ORIGINS=https://pranshusharma.tech,https://www.pranshusharma.tech

# Authentication & Cryptographic Secrets
JWT_SECRET=generate_with_openssl_rand_hex_32
SERVER_PEPPER=generate_with_openssl_rand_hex_32

# AWS Mumbai (ap-south-1) Configuration
AWS_DEFAULT_REGION=ap-south-1
S3_BACKUP_BUCKET=smartbus-backups-pranshusharma.tech
SES_FROM_EMAIL=login@pranshusharma.tech

# Web Push Notification Keys (VAPID)
VAPID_PUBLIC_KEY=replace_with_vapid_public_key
VAPID_PRIVATE_KEY=replace_with_vapid_private_key
VAPID_CLAIMS_SUB=mailto:admin@pranshusharma.tech
